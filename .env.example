POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_password

PRODUCT_DB=product_db
INVENTORY_DB=inventory_db
PURCHASE_DB=purchase_db
SALE_DB=sale_db
NOTIFICATION_DB=notification_db

PRODUCT_SERVICE_URL=http://product-service:8081
INVENTORY_SERVICE_URL=http://inventory-service:8082
PURCHASE_SERVICE_URL=http://purchase-service:8083
SALE_SERVICE_URL=http://sale-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8085

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ENDPOINT_URL_SQS=http://localstack:4566
SQS_ENDPOINT_STRATEGY=path
SQS_LISTENER_AUTO_STARTUP=true

PURCHASE_EVENTS_QUEUE=purchase-events
STOCK_RESERVATION_REQUESTS_QUEUE=stock-reservation-requests
SALE_EVENTS_QUEUE=sale-events
STOCK_RESERVED_QUEUE=stock-reserved
STOCK_INSUFFICIENT_QUEUE=stock-insufficient
LOW_STOCK_ALERTS_QUEUE=low-stock-alerts

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN_ALT=http://127.0.0.1:5173